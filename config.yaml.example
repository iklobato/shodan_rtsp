# Copy to config.yaml (git-ignored) and fill in. Single source of config + keys.

shodan:
  api_key: "<your_shodan_api_key>"
  query: "screenshot.label:webcam,cam country:BR"

checkers:
  wordlist_users: wordlists/users_small.txt
  wordlist_passwords: wordlists/passwords_small.txt
  wordlist_rtsp_urls: wordlists/rtsp_urls_small.txt
  randomize: true
  concurrency: 1              # parallel RTSP probes; raise to speed up, bounded by the proxy exit

nmap:
  ip_range: 200.128.0.0/24
  parallelism: 0             # > 0 runs nmap with -T4 --min-parallelism N; 0 = nmap defaults
  xml_path: logs/nmap.xml    # raw XML of the run; this is what --start_vuln_scan reads

proxy:
  # false = connect straight from the local IP. Required for a private range
  # (192.168.x.x is unreachable through a residential exit) and for a local
  # scan while the 2captcha account is down. Keep true for public scans.
  enabled: true
  token: "<your_2captcha_token>"
  auth_mode: whitelist        # whitelist | login
  protocol: socks5            # http | https | socks5
  country: us
  public_ip: ""               # whitelist mode; auto-detected when empty
  gateway_host: ""            # login mode only
  gateway_port: 0             # login mode only
  gateway_password: ""        # login mode only

vuln:
  # Names the CVEs that cover what an nmap or Shodan scan already collected.
  # It never sends a payload or contacts a device.
  nmap_xml: logs/nmap.xml     # the XML --start_nmap writes (nmap.xml_path)
  feed_path: nvdcve-2.0.json  # NVD 2.0 JSON; see the README for how to build a subset
  cpe_map_path: cpe_map.yaml  # product string -> CPE vendor:product
  min_cvss: 0.0               # drop findings below this base score
  report_path: logs/vuln_report.json

face:
  enabled: true               # set false to skip face scan
  frames_per_scan: 5          # frames per camera per scan
  frame_interval: 2.0         # seconds between frames
  match_threshold: 0.5        # cosine distance below = same person
  save_frames: true           # save face frames to DB

database:
  # dockerized postgres, e.g.:
  #   docker run -d --name shodan_pg -e POSTGRES_USER=scanner \
  #     -e POSTGRES_PASSWORD=scanner -e POSTGRES_DB=cameras -p 5433:5432 postgres:16
  user: "<postgres_user>"
  password: "<postgres_password>"
  host: "localhost:5433"   # host[:port]; 5433 avoids clashing with a local 5432
  db: "cameras"
