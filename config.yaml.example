# Copy to config.yaml (git-ignored) and fill in. Single source of config + keys.

shodan:
  api_key: "<your_shodan_api_key>"
  # A query runs only when it names the range it may reach (`net:`) and that
  # range is declared under `targets` (D18, FR-001). Without both, the scan is
  # refused before any API call: Shodan cannot be asked whether a result set
  # stays inside a range, so a query with no `net:` filter reaches the whole
  # index.
  query: "net:203.0.113.0/24 screenshot.label:webcam,cam"

targets:
  # The one list of what this scanner may reach (D18, FR-001). It guards the
  # Shodan query and every command that reaches a stored camera, so the
  # authorization is written once. Empty authorizes nothing: a check run over
  # cameras already in the database is refused until its addresses are here.
  # A run narrowed with `scan check --camera-id N` reaches the camera the
  # operator named, which is the authorization itself.
  allowed_cidrs: ["203.0.113.0/24"]  # your lab, or a range you may scan in writing

checkers:
  wordlist_users: wordlists/users_small.txt
  wordlist_passwords: wordlists/passwords_small.txt
  wordlist_rtsp_urls: wordlists/rtsp_urls_small.txt
  randomize: true
  concurrency: 1              # parallel RTSP probes; raise to speed up, bounded by the cameras

nmap:
  ip_range: 192.168.1.0/24    # your own lab or a written-authorized range
  # RTSP plus the web and ONVIF ports most cameras expose instead of it (D15)
  ports: [554, 80, 443, 8000, 8080, 8554, 34567]
  parallelism: 0             # > 0 runs nmap with -T4 --min-parallelism N; 0 = nmap defaults
  xml_path: logs/nmap.xml    # raw XML of the run, kept as the record of what nmap saw

vuln:
  # Names the CVEs that cover what a scan already stored, then reads each match
  # once through the read-only classes of the batch. Nothing is written to a
  # device and no payload is sent (D9, D30).
  feed_path: nvdcve-2.0.json  # NVD 2.0 JSON; see the README for how to build a subset
  cpe_map_path: cpe_map.yaml  # product string -> CPE vendor:product
  min_cvss: 0.0               # drop findings below this base score
  web_ports: [80, 443, 8000, 8080]  # tried after the port the camera was seen on
  timeout_seconds: 8.0        # one network step; the RTSP probe uses the same bound

face:
  enabled: true               # set false to skip face scan
  frames_per_scan: 5          # frames per camera per scan
  frame_interval: 2.0         # seconds between frames
  # Cosine similarity over the L2-normalized 512-d embedding: higher means more
  # alike, 1.0 is the same direction. PLACEHOLDER until `measure threshold` runs
  # over a labelled pair set (D16, D44, SC-010).
  match_threshold: 0.5
  pairs_path: lab/faces       # labelled pair set `measure threshold` reads by default

person_search:
  # Cosine similarity a stored face needs to count as the registered target.
  # A value of its own, not face.match_threshold: grouping asks when two faces
  # are one person, this asks when a face is the person the operator named.
  # PLACEHOLDER until it is measured on this data (D51, D60).
  match_threshold: 0.5

frames:
  # Frames are files on disk and the database holds the path (D17). The layout
  # under this root is <root>/<camera_id>/<timestamp>-<source>.jpg (R8).
  root_path: logs/frames

brands:
  # Brand signatures and the brand credential sets, as data (D27)
  signature_path: brands.yaml

database:
  # dockerized postgres, e.g.:
  #   docker compose up -d postgres
  user: "<postgres_user>"
  password: "<postgres_password>"
  host: "localhost:5440"   # host[:port]; 5432 and 5433 are taken on this host
  # A container reaches the database at another address, so DATABASE_HOST
  # overrides this one value: host.docker.internal:5440 for `docker run`, or
  # postgres:5432 inside the compose network (the scanner service sets it).
  db: "cameras"
